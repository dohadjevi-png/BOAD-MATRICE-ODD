import React, { useState } from "react";
import { 
  auth, 
  db 
} from "../lib/firebase";
import { 
  signInWithPopup, 
  GoogleAuthProvider, 
  signInWithEmailAndPassword, 
  createUserWithEmailAndPassword, 
  updateProfile 
} from "firebase/auth";
import { Landmark, Mail, Lock, User, Chrome, AlertCircle, Loader2 } from "lucide-react";

interface LoginScreenProps {
  onAuthSuccess: () => void;
}

export default function LoginScreen({ onAuthSuccess }: LoginScreenProps) {
  const [isSignUp, setIsSignUp] = useState(false);
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [displayPrénom, setDisplayPrénom] = useState("");
  const [errorMsg, setErrorMsg] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);

  const handleGoogleSignIn = async () => {
    setLoading(true);
    setErrorMsg(null);
    try {
      const provider = new GoogleAuthProvider();
      // Use signInWithPopup which is compatible with AI Studio preview environments
      await signInWithPopup(auth, provider);
      onAuthSuccess();
    } catch (err: any) {
      console.error("Google Auth failed:", err);
      if (err.code === "auth/operation-not-allowed") {
        setErrorMsg("La connexion Google n'est pas encore activée dans la console Firebase. Veuillez utiliser la connexion email/mot de passe.");
      } else if (err.message && err.message.includes("placeholder")) {
        setErrorMsg("Configuration Firebase en attente. Veuillez accepter les conditions d'utilisation Firebase dans l'interface de Google AI Studio puis rechargez.");
      } else {
        setErrorMsg("La connexion Google a échoué. (" + (err.message || err.code) + ")");
      }
    } finally {
      setLoading(false);
    }
  };

  const handleEmailAuth = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!email.trim() || !password.trim()) {
      setErrorMsg("Veuillez remplir tous les champs.");
      return;
    }
    if (isSignUp && !displayPrénom.trim()) {
      setErrorMsg("Veuillez renseigner votre prénom ou nom pour l'inscription.");
      return;
    }
    if (password.length < 6) {
      setErrorMsg("Le mot de passe doit contenir au moins 6 caractères.");
      return;
    }

    setLoading(true);
    setErrorMsg(null);
    try {
      if (isSignUp) {
        // Sign up
        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
        // Save displayName / Prénom
        await updateProfile(userCredential.user, {
          displayName: displayPrénom.trim()
        });
        onAuthSuccess();
      } else {
        // Sign in
        await signInWithEmailAndPassword(auth, email, password);
        onAuthSuccess();
      }
    } catch (err: any) {
      console.error("Email auth failed:", err);
      // Friendly messages for common Firebase errors in French
      switch (err.code) {
        case "auth/invalid-credential":
        case "auth/wrong-password":
        case "auth/user-not-found":
          setErrorMsg("Adresse email ou mot de passe incorrect.");
          break;
        case "auth/email-already-in-use":
          setErrorMsg("Cette adresse email est déjà associée à un compte existant.");
          break;
        case "auth/invalid-email":
          setErrorMsg("Format de courrier électronique invalide.");
          break;
        case "auth/weak-password":
          setErrorMsg("Le mot de passe choisi est trop faible.");
          break;
        case "auth/configuration-not-found":
        case "auth/operation-not-allowed":
          setErrorMsg("Cette méthode de connexion est en cours d'activation dans la console Firebase.");
          break;
        default:
          if (err.message && err.message.includes("placeholder")) {
            setErrorMsg("Configuration Firebase en attente. Veuillez accepter les conditions d'utilisation Firebase dans l'interface de Google AI Studio puis recharger la page.");
          } else {
            setErrorMsg(err.message || "Une erreur est survenue lors de l'authentification.");
          }
      }
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-sans">
      <div className="sm:mx-auto sm:w-full sm:max-w-md">
        <div className="flex justify-center">
          <div className="bg-[#003366] p-4 rounded-xl shadow-lg border-2 border-[#009933] flex items-center justify-center">
            <Landmark className="h-10 w-10 text-white" />
          </div>
        </div>
        
        <h2 className="mt-6 text-center text-3xl font-extrabold text-[#003366] tracking-tight">
          Matrice ODD BOAD
        </h2>
        <p className="mt-2 text-center text-xs font-semibold text-[#009933] uppercase tracking-widest font-mono">
          Banque Ouest-Africaine de Développement
        </p>
      </div>

      <div className="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div className="bg-white py-8 px-4 shadow-xl rounded-2xl border border-slate-200/60 sm:px-10">
          
          <h3 className="text-base font-bold text-slate-800 mb-6 border-b pb-3 uppercase tracking-wider text-center">
            {isSignUp ? "Création de compte" : "Portail d'Authentification"}
          </h3>

          {errorMsg && (
            <div className="rounded-lg bg-red-50 p-4 mb-5 border border-red-200 flex items-start gap-2.5">
              <AlertCircle className="h-5 w-5 text-red-500 shrink-0 mt-0.5" />
              <div className="text-xs text-red-700 font-semibold leading-relaxed">
                {errorMsg}
              </div>
            </div>
          )}

          {/* Regular form */}
          <form className="space-y-4" onSubmit={handleEmailAuth}>
            {isSignUp && (
              <div>
                <label className="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
                  Prénom / Nom d'utilisateur
                </label>
                <div className="relative rounded-md shadow-xs">
                  <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <User className="h-4 w-4 text-slate-400" />
                  </div>
                  <input
                    type="text"
                    required={isSignUp}
                    value={displayPrénom}
                    onChange={(e) => setDisplayPrénom(e.target.value)}
                    placeholder="Ex. Jordan"
                    className="block w-full pl-10 pr-3 py-2 text-sm border border-slate-300 rounded-lg outline-none focus:border-[#003366] focus:ring-1 focus:ring-[#003366]"
                  />
                </div>
              </div>
            )}

            <div>
              <label className="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
                Adresse email professionnelle
              </label>
              <div className="relative rounded-md shadow-xs">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <Mail className="h-4 w-4 text-slate-400" />
                </div>
                <input
                  type="email"
                  required
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="nom@boad.int"
                  className="block w-full pl-10 pr-3 py-2 text-sm border border-slate-300 rounded-lg outline-none focus:border-[#003366] focus:ring-1 focus:ring-[#003366]"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
                Mot de passe
              </label>
              <div className="relative rounded-md shadow-xs">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <Lock className="h-4 w-4 text-slate-400" />
                </div>
                <input
                  type="password"
                  required
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="••••••••"
                  className="block w-full pl-10 pr-3 py-2 text-sm border border-slate-300 rounded-lg outline-none focus:border-[#003366] focus:ring-1 focus:ring-[#003366]"
                />
              </div>
            </div>

            <div className="pt-2">
              <button
                type="submit"
                disabled={loading}
                className="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-[#003366] hover:bg-[#002244] active:scale-98 transition focus:outline-none cursor-pointer disabled:bg-slate-400"
              >
                {loading ? (
                  <Loader2 className="h-5 w-5 animate-spin" />
                ) : isSignUp ? (
                  "Créer un compte professionnel"
                ) : (
                  "Se connecter"
                )}
              </button>
            </div>
          </form>

          {/* Social connection divider */}
          <div className="mt-6">
            <div className="relative">
              <div className="absolute inset-0 flex items-center">
                <div className="w-full border-t border-slate-200"></div>
              </div>
              <div className="relative flex justify-center text-xs uppercase font-bold tracking-wide">
                <span className="px-2 bg-white text-slate-400">Ou</span>
              </div>
            </div>

            <div className="mt-5">
              <button
                type="button"
                onClick={handleGoogleSignIn}
                disabled={loading}
                className="w-full inline-flex justify-center items-center gap-2 py-2.5 px-4 border border-slate-300 rounded-lg shadow-sm bg-white text-sm font-bold text-slate-700 hover:bg-slate-50 active:scale-98 transition cursor-pointer select-none disabled:bg-slate-100 disabled:text-slate-400"
              >
                <Chrome className="h-4.5 w-4.5 text-red-500" />
                <span>Se connecter avec Google</span>
              </button>
            </div>
          </div>

          {/* Mode Switcher */}
          <div className="mt-6 text-center text-xs">
            {isSignUp ? (
              <p className="text-slate-500">
                Vous possédez déjà un compte ?{" "}
                <button
                  type="button"
                  onClick={() => {
                    setIsSignUp(false);
                    setErrorMsg(null);
                  }}
                  className="font-bold text-[#003366] hover:underline cursor-pointer"
                >
                  Identifiez-vous ici
                </button>
              </p>
            ) : (
              <p className="text-slate-500">
                Nouveau sur la plateforme ?{" "}
                <button
                  type="button"
                  onClick={() => {
                    setIsSignUp(true);
                    setErrorMsg(null);
                  }}
                  className="font-bold text-[#003366] hover:underline cursor-pointer"
                >
                  Créer un compte libre
                </button>
              </p>
            )}
          </div>

        </div>
      </div>

      <div className="mt-8 text-center text-[10px] text-slate-400 font-mono tracking-wider uppercase">
        Outil de scoring RSE conforme aux directives d'alignement ODD
      </div>
    </div>
  );
}
