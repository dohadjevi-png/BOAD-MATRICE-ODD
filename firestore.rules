rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'titre', 'description', 'secteur', 'pays', 'montant', 'createdAt'])
          && data.id is string && data.id.size() <= 128
          && data.titre is string && data.titre.size() <= 500
          && data.description is string && data.description.size() <= 50000
          && data.secteur is string && data.secteur.size() <= 200
          && data.pays is string && data.pays.size() <= 100
          && data.montant is string && data.montant.size() <= 100
          && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Rules for individual subcollections
    match /users/{userId}/projects/{projectId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && isValidId(projectId) 
                    && isValidProject(incoming());
      allow update: if isOwner(userId) 
                    && isValidId(projectId) 
                    && isValidProject(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
